# Production settings for docker compose (T16). Copy to deploy/.env:
#   cp .env.example .env && chmod 600 .env
# Compose reads this file for ${...} in the compose files, and passes it to
# the app as its environment (env_file). Never commit .env.

# --- Compose: reverse proxy ------------------------------------------------
# Option A, the bundled Caddy (default): ports 80/443, automatic certificates.
COMPOSE_PROFILES=caddy
# Option B, an existing Traefik v3 instead (see README.md): no Caddy
# container, `app` joins Traefik's network.
# COMPOSE_PROFILES=
# TRAEFIK_NETWORK=traefik          # Traefik's external Docker network
# B1, the route from Docker labels:
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml:docker-compose.traefik-labels.yml
# TRAEFIK_ENTRYPOINT=websecure     # its HTTPS entrypoint
# TRAEFIK_CERTRESOLVER=letsencrypt # its ACME certificate resolver
# B2, the route in your own Traefik config (e.g. traefik/pickem.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml

# Public hostname of the Activity, without https://. Its DNS record points
# to your home IP. Also the Discord URL mapping target (docs/discord-setup.md).
DOMAIN=pickem.example.com

# --- Compose: image ---------------------------------------------------------
# GHCR image without tag; the owner must be lowercase.
APP_IMAGE=ghcr.io/your-github-user/cs2-pickem
# `latest` follows main. For a rollback pin a build: IMAGE_TAG=sha-<short>.
IMAGE_TAG=latest
# The app runs as this user and group; it must own ./data (`id -u`, `id -g`).
APP_UID=1000
APP_GID=1000

# --- App: Discord application (required) -------------------------------------
# Setup: docs/discord-setup.md. Use the production application here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Recommended: only accept this server (guild) ID.
DISCORD_GUILD_ID=

# --- App: data sources -------------------------------------------------------
# Comma-separated: pandascore, manual. Default: pandascore.
ENABLED_SOURCES=pandascore
# Required while `pandascore` is enabled.
PANDASCORE_TOKEN=

# --- App: optional -------------------------------------------------------------
# The image sets DATABASE_URL=sqlite:///data/pickem.db,
# IMAGE_CACHE_DIR=/data/img-cache, STATIC_DIR=/app/dist,
# BIND_ADDR=0.0.0.0:8080, LOG_FORMAT=json and RUST_LOG=info. Override only
# if you know why; the proxies expect port 8080.
# RUST_LOG=info
# BUDGET__PANDASCORE__PER_HOUR=500
# BUDGET__PANDASCORE__PER_MINUTE=30
