# Copy to .env (repo root) for local development: cp .env.example .env
# `cargo run` in backend/ finds it by walking up from the working directory.
# Real environment variables always win over .env. Never commit .env.
#
# Relative paths below are relative to backend/, where you run `cargo run`.

# --- Discord application (required) -------------------------------------
# Setup: docs/discord-setup.md. Placeholders are fine for a dev build in a
# normal browser (dev sign-in); signing in inside Discord needs real values.
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=change-me
DISCORD_BOT_TOKEN=change-me
# Optional but recommended: only accept this server (guild) ID.
DISCORD_GUILD_ID=

# --- Database (required) -------------------------------------------------
# SQLite file; created with its directory on first start.
DATABASE_URL=sqlite://data/dev.db

# --- Data sources --------------------------------------------------------
# Comma-separated: pandascore, manual, fixture. Default: pandascore.
# `fixture` (dev scenario plus fake clock, no token needed) only exists in
# dev builds: ENABLED_SOURCES=fixture cargo run --features dev
ENABLED_SOURCES=pandascore
# Required while `pandascore` is enabled.
PANDASCORE_TOKEN=change-me
# The only source that creates events, teams and matches (T03). Default: the
# first non-manual entry of ENABLED_SOURCES. Field precedence is set in
# config.toml under [precedence].
# PRIMARY_SOURCE=pandascore

# --- Logging -------------------------------------------------------------
# pretty (default) or json
LOG_FORMAT=pretty
RUST_LOG=info,tower_http=debug

# --- HTTP ----------------------------------------------------------------
BIND_ADDR=127.0.0.1:8080
# Built frontend (`pnpm build`), served at /.
STATIC_DIR=../frontend/dist
# Disk cache of the image proxy (avatars, team logos). Default: data/img-cache
# IMAGE_CACHE_DIR=data/img-cache

# --- Request budget per source (T06), optional -------------------------
# Defaults: 50% of PandaScore's free plan.
# BUDGET__PANDASCORE__PER_HOUR=500
# BUDGET__PANDASCORE__PER_MINUTE=30

# --- Optional config file --------------------------------------------
# Non-secret settings may also live in a TOML file; see config.example.toml.
# Default: ./config.toml if it exists.
# CONFIG_FILE=config.toml
