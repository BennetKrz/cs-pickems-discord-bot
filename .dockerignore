# Allow-list: the build context holds only what the Dockerfile needs, so no
# .env, database, target/ or node_modules ever reaches the image or a cache.
*
!backend/Cargo.toml
!backend/Cargo.lock
!backend/crates/
!frontend/

backend/crates/**/target/
frontend/node_modules/
frontend/dist/
frontend/coverage/
**/*.tsbuildinfo
**/.env
**/.env.*
**/*.db
**/*.db-shm
**/*.db-wal
